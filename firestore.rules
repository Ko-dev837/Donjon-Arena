rules_version = '2';
// =====================================================================
//  Donjon Arena 3D — règles Firestore du mode en ligne
//  Collections : users (+ requests, friends), codes, guilds (+ members, chat, log), guildCodes
//  Principes : chacun n'écrit que son profil ; les amitiés exigent une demande ;
//  seuls les membres d'une guilde lisent la guilde, ses membres et son chat ;
//  types et tailles validés ; tout le reste est refusé.
// =====================================================================
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function me() { return request.auth.uid; }
    function str(v, min, max) { return v is string && v.size() >= min && v.size() <= max; }
    function optStr(d, k, max) { return !(k in d) || d[k] == null || str(d[k], 0, max); }
    function code6(c) { return c is string && c.matches('^[A-Z2-9]{6}$'); }
    function changed() { return request.resource.data.diff(resource.data).affectedKeys(); }

    // ------------------------------------------------------------ profils
    match /users/{uid} {
      allow read: if signedIn();
      allow create: if signedIn() && me() == uid && validUser(request.resource.data)
        && exists(/databases/$(database)/documents/codes/$(request.resource.data.code))
        && get(/databases/$(database)/documents/codes/$(request.resource.data.code)).data.uid == uid;
      allow update: if signedIn() && me() == uid && validUser(request.resource.data)
        && request.resource.data.code == resource.data.code
        && guildOk(uid);
      allow delete: if false;

      function validUser(d) {
        return d.keys().hasOnly(['name', 'code', 'guildId', 'classe', 'rank', 'niveau', 'skin', 'photo', 'updated'])
          && str(d.name, 1, 20) && code6(d.code)
          && optStr(d, 'classe', 20) && optStr(d, 'rank', 3) && optStr(d, 'skin', 40)
          && (!('niveau' in d) || (d.niveau is int && d.niveau >= 0 && d.niveau <= 999))
          && (!('photo' in d) || d.photo == null || (str(d.photo, 8, 500) && d.photo.matches('^https://.*')))
          && (!('guildId' in d) || d.guildId == null || str(d.guildId, 1, 40))
          && (!('updated' in d) || d.updated == request.time || (resource != null && d.updated == resource.data.get('updated', null)));
      }
      // guildId ne peut pointer que vers une guilde dont on est (ou devient) membre
      function guildOk(uid) {
        let g = request.resource.data.get('guildId', null);
        return g == null || g == resource.data.get('guildId', null)
          || existsAfter(/databases/$(database)/documents/guilds/$(g)/members/$(uid));
      }

      // demandes d'ami reçues : écrites par l'expéditeur, lues par le destinataire
      match /requests/{from} {
        allow read: if signedIn() && me() == uid;
        allow create: if signedIn() && me() == from && from != uid
          && request.resource.data.keys().hasOnly(['name', 'at'])
          && str(request.resource.data.name, 1, 20) && request.resource.data.at == request.time;
        allow delete: if signedIn() && (me() == uid || me() == from);
        allow update: if false;
      }

      // amis : créés uniquement en acceptant une demande existante
      match /friends/{fid} {
        allow read: if signedIn() && me() == uid;
        allow create: if signedIn() && uid != fid
          && request.resource.data.keys().hasOnly(['since']) && request.resource.data.since == request.time
          && ((me() == uid && exists(/databases/$(database)/documents/users/$(uid)/requests/$(fid)))
            || (me() == fid && exists(/databases/$(database)/documents/users/$(fid)/requests/$(uid))));
        allow delete: if signedIn() && (me() == uid || me() == fid);
        allow update: if false;
      }
    }

    // ------------------------------------------------------------ codes ami (code → uid)
    match /codes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code6(code)
        && request.resource.data.keys().hasOnly(['uid']) && request.resource.data.uid == me();
      allow update, delete: if false;
    }

    // ------------------------------------------------------------ guildes
    //  Rôles : chef > officier > membre > recrue (rôle absent ou inconnu = membre côté client).
    //  Champs facultatifs de guilds/{gid} (absents sur les anciennes guildes) :
    //    motd (≤ 200), emblem { icon, color }, open (booléen, absent = ouvert).
    function guildPath(gid) { return /databases/$(database)/documents/guilds/$(gid); }
    function memberPath(gid, uid) { return /databases/$(database)/documents/guilds/$(gid)/members/$(uid); }
    function isMember(gid) { return signedIn() && exists(memberPath(gid, request.auth.uid)); }
    function roleOf(gid) { return get(memberPath(gid, request.auth.uid)).data.role; }
    function validEmblem(e) {
      return e is map && e.keys().hasOnly(['icon', 'color'])
        && e.icon is string && e.icon.matches('^[a-z]{1,20}$')
        && e.color is string && e.color.matches('^#[0-9a-fA-F]{6}$');
    }
    function validGuild(d) {
      return d.keys().hasOnly(['name', 'tag', 'code', 'leader', 'created', 'motd', 'emblem', 'open'])
        && (!('motd' in d) || str(d.motd, 0, 200))
        && (!('emblem' in d) || validEmblem(d.emblem))
        && (!('open' in d) || d.open is bool);
    }

    match /guilds/{gid} {
      allow read: if isMember(gid);
      allow create: if signedIn()
        && validGuild(request.resource.data)
        && request.resource.data.leader == me()
        && str(request.resource.data.name, 3, 24)
        && request.resource.data.tag is string && request.resource.data.tag.matches('^[A-Z0-9]{3,4}$')
        && code6(request.resource.data.code)
        && request.resource.data.created == request.time
        && existsAfter(memberPath(gid, request.auth.uid))
        && getAfter(/databases/$(database)/documents/guildCodes/$(request.resource.data.code)).data.gid == gid;
      allow update: if signedIn() && validGuild(request.resource.data) && (
          // le chef transmet la direction à un membre devenu chef dans le même lot
          (resource.data.leader == me() && changed().hasOnly(['leader'])
            && getAfter(memberPath(gid, request.resource.data.leader)).data.role == 'chef')
          // message du jour : chef ou officier
          || (changed().hasOnly(['motd']) && roleOf(gid) in ['chef', 'officier'])
          // réglages : recrutement et emblème, chef seulement
          || (resource.data.leader == me() && changed().hasOnly(['open', 'emblem']))
        );
      allow delete: if signedIn() && resource.data.leader == me();

      match /members/{uid} {
        allow read: if isMember(gid);
        allow create: if signedIn() && me() == uid
          && request.resource.data.keys().hasOnly(['name', 'role', 'code', 'joined', 'lastMsg'])
          && str(request.resource.data.name, 1, 20)
          && request.resource.data.joined == request.time && request.resource.data.lastMsg == request.time
          && (
            // fondateur : la guilde est créée dans le même lot, avec lui comme chef
            (request.resource.data.role == 'chef' && !exists(guildPath(gid))
              && getAfter(guildPath(gid)).data.leader == uid)
            // nouvel arrivant : recrue, connaît le code, et le recrutement n'est pas fermé
            || (request.resource.data.role == 'recrue' && exists(guildPath(gid))
              && request.resource.data.code == get(guildPath(gid)).data.code
              && get(guildPath(gid)).data.get('open', true) != false)
          );
        allow update: if signedIn() && changed().size() > 0 && (
          // soi-même : pseudo et horodatage anti-spam uniquement
          (me() == uid && changed().hasOnly(['name', 'lastMsg']) && str(request.resource.data.name, 1, 20)
            && (!('lastMsg' in changed()) || request.resource.data.lastMsg == request.time))
          // l'ancien chef devient officier, dans le lot qui confie la direction à un autre membre devenu chef
          || (me() == uid && resource.data.role == 'chef' && changed().hasOnly(['role'])
            && request.resource.data.role == 'officier'
            && getAfter(guildPath(gid)).data.leader != uid
            && getAfter(memberPath(gid, getAfter(guildPath(gid)).data.leader)).data.role == 'chef')
          // le chef change le rôle d'un autre membre (jamais d'un chef) : officier, membre ou recrue
          || (me() != uid && roleOf(gid) == 'chef' && changed().hasOnly(['role'])
            && resource.data.role != 'chef'
            && request.resource.data.role in ['officier', 'membre', 'recrue'])
          // un officier promeut une recrue en membre, et rien d'autre
          || (me() != uid && roleOf(gid) == 'officier' && changed().hasOnly(['role'])
            && resource.data.role == 'recrue' && request.resource.data.role == 'membre')
          // le chef transmet la guilde (même lot que la mise à jour de guilds/{gid}.leader)
          || (me() != uid && roleOf(gid) == 'chef' && changed().hasOnly(['role'])
            && request.resource.data.role == 'chef'
            && getAfter(guildPath(gid)).data.leader == uid)
        );
        allow delete: if signedIn() && (
          // quitter (le chef doit d'abord transmettre la guilde, sauf s'il la dissout)
          (me() == uid && (resource.data.role != 'chef'
            || !existsAfter(guildPath(gid))
            || getAfter(guildPath(gid)).data.leader != uid))
          // exclusion par le chef (tout membre sauf un chef)
          || (me() != uid && roleOf(gid) == 'chef' && resource.data.role != 'chef')
          // exclusion par un officier : membres et recrues seulement
          || (me() != uid && roleOf(gid) == 'officier' && resource.data.role in ['membre', 'recrue'])
        );
      }

      // chat : membres seulement ; 1 message toutes les 2 s au plus (horodatage serveur lastMsg)
      match /chat/{mid} {
        allow read: if isMember(gid);
        allow create: if isMember(gid)
          && request.resource.data.keys().hasOnly(['uid', 'name', 'text', 'at'])
          && request.resource.data.uid == me()
          && str(request.resource.data.name, 1, 20)
          && str(request.resource.data.text, 1, 200)
          && request.resource.data.at == request.time
          && getAfter(memberPath(gid, request.auth.uid)).data.lastMsg == request.time
          && request.time > get(memberPath(gid, request.auth.uid)).data.lastMsg + duration.value(2, 's');
        // modération : l'auteur, le chef ou un officier peuvent supprimer
        allow delete: if isMember(gid) && (resource.data.uid == me() || roleOf(gid) in ['chef', 'officier']);
        allow update: if false;
      }

      // journal : écrit par l'auteur de l'action, membre avant ou après le lot (départ, arrivée, création)
      match /log/{lid} {
        allow read: if isMember(gid);
        allow create: if signedIn()
          && (exists(memberPath(gid, request.auth.uid)) || existsAfter(memberPath(gid, request.auth.uid)))
          && request.resource.data.keys().hasOnly(['uid', 'name', 'type', 'text', 'at'])
          && request.resource.data.uid == me()
          && str(request.resource.data.name, 1, 20)
          && request.resource.data.type in ['creation', 'arrivee', 'depart', 'promotion', 'retrogradation', 'exclusion', 'transfert', 'motd']
          && str(request.resource.data.text, 1, 120)
          && request.resource.data.at == request.time;
        // effacé seulement par le chef (dissolution)
        allow delete: if isMember(gid) && roleOf(gid) == 'chef';
        allow update: if false;
      }
    }

    // ------------------------------------------------------------ codes de guilde (code → gid)
    match /guildCodes/{code} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn() && code6(code)
        && request.resource.data.keys().hasOnly(['gid']) && request.resource.data.gid is string
        && getAfter(guildPath(request.resource.data.gid)).data.code == code
        && getAfter(guildPath(request.resource.data.gid)).data.leader == me();
      // le chef recopie l'état du recrutement (open) pour que les non-membres sachent si le code fonctionne
      allow update: if signedIn()
        && request.resource.data.keys().hasOnly(['gid', 'open'])
        && changed().hasOnly(['open'])
        && request.resource.data.open is bool
        && get(guildPath(resource.data.gid)).data.leader == me()
        && getAfter(guildPath(resource.data.gid)).data.open == request.resource.data.open;
      allow delete: if signedIn() && get(guildPath(resource.data.gid)).data.leader == me();
    }
  }
}
